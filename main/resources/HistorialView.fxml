<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Visualcontroller.HistorialController">
    <children>
        <Label layoutX="50.0" layoutY="20.0" text="Historial de Mis Compras">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <TableView fx:id="tblCompras" layoutX="50.0" layoutY="70.0" prefHeight="250.0" prefWidth="500.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="ID Compra" />
                <TableColumn fx:id="colEvento" prefWidth="150.0" text="Evento" />
                <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha" />
                <TableColumn fx:id="colTotal" prefWidth="80.0" text="Total ($)" />
                <TableColumn fx:id="colEstado" prefWidth="70.0" text="Estado" />
            </columns>
        </TableView>

        <Button fx:id="btnVolver" layoutX="50.0" layoutY="340.0"
                mnemonicParsing="false" onAction="#handleVolver" text="Volver al Dashboard" />
    </children>
</AnchorPane>
