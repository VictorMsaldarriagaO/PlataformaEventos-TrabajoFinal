<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Visualcontroller.CompraController">
    <children>
        <Label layoutX="50.0" layoutY="20.0" text="Detalles de la Compra">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label fx:id="lblInfoEvento" layoutX="50.0" layoutY="60.0" text="Cargando información del evento..." textFill="GRAY" />

        <Separator layoutX="50.0" layoutY="90.0" prefWidth="500.0" />

        <!-- Nueva sección de selección de ubicación -->
        <Label layoutX="50.0" layoutY="105.0" text="Selección de Ubicación:">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <ComboBox fx:id="cmbZonas"
                  layoutX="50.0"
                  layoutY="135.0"
                  onAction="#handleCambioZona"
                  prefWidth="200.0"
                  promptText="Seleccione Zona" />

        <ComboBox fx:id="cmbAsientos"
                  layoutX="270.0"
                  layoutY="135.0"
                  prefWidth="200.0"
                  promptText="Seleccione Asiento" />

        <Separator layoutX="50.0" layoutY="180.0" prefWidth="500.0" />

        <Label layoutX="50.0" layoutY="200.0" text="Servicios Adicionales (Patrón Decorator):">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <CheckBox fx:id="chkVip"
                  layoutX="50.0"
                  layoutY="230.0"
                  mnemonicParsing="false"
                  onAction="#handleCambioAdicionales"
                  text="Añadir Acceso VIP (+$50,000)" />

        <CheckBox fx:id="chkSeguro"
                  layoutX="50.0"
                  layoutY="260.0"
                  mnemonicParsing="false"
                  onAction="#handleCambioAdicionales"
                  text="Añadir Seguro de Cancelación (+$15,000)" />

        <Separator layoutX="50.0" layoutY="300.0" prefWidth="500.0" />

        <Label fx:id="lblTotal" layoutX="50.0" layoutY="320.0" text="Total a Pagar: $0.0" textFill="GREEN">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TextField fx:id="txtTarjeta"
                   layoutX="50.0"
                   layoutY="370.0"
                   prefHeight="30.0"
                   prefWidth="250.0"
                   promptText="Número de Tarjeta (Simulada)" />

        <Button fx:id="btnProcesar"
                layoutX="320.0"
                layoutY="367.0"
                mnemonicParsing="false"
                onAction="#handleProcesarCompra"
                prefHeight="35.0"
                prefWidth="130.0"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;"
                text="Procesar Pago">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
        <Button fx:id="btnCancelar"
                layoutX="320.0"
                layoutY="430.0"
                mnemonicParsing="false"
                onAction="#handleCancelarCompra"
                prefHeight="35.0" prefWidth="170.0"
                text="Cancelar y Volver" />

        <Label fx:id="lblResultado"
               layoutX="50.0"
               layoutY="420.0"
               prefWidth="500.0"
               wrapText="true" />
    </children>
</AnchorPane>