<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Visualcontroller.DashboardAdministradorController">

    <children>

        <VBox alignment="CENTER"
              spacing="15.0"
              AnchorPane.topAnchor="40.0"
              AnchorPane.leftAnchor="120.0"
              AnchorPane.rightAnchor="120.0">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Título -->
            <Label fx:id="lblBienvenida"
                   text="Panel de Control - Administrador"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;" />

            <!-- Selección de Reporte -->
            <Label text="Seleccione el tipo de reporte:" />

            <ComboBox fx:id="cbTipoReporte"
                      prefWidth="200.0" />

            <!-- Botón Generar Reporte -->
            <Button fx:id="btnGenerar"
                    text="Generar Reporte"
                    onAction="#handleGenerarReporte"
                    prefWidth="220.0" />

            <!-- NUEVOS BOTONES -->
            <Button text="Gestión de Eventos"
                    onAction="#handleIrGestionEventos"
                    prefWidth="220.0" />

            <Button text="Ver Métricas"
                    onAction="#handleIrMetricas"
                    prefWidth="220.0" />

            <!-- Resultado -->
            <Label fx:id="lblResultado"
                   wrapText="true"
                   style="-fx-font-size: 13px;" />

            <!-- Cerrar sesión -->
            <Button text="Cerrar Sesión"
                    onAction="#handleCerrarSesion"
                    prefWidth="220.0"
                    style="-fx-background-color: #d9534f; -fx-text-fill: white;" />

        </VBox>

    </children>
</AnchorPane>