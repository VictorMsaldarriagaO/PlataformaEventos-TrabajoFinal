<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Visualcontroller.MetricasAdministradorController">
    <children>
        <Label layoutX="30.0" layoutY="20.0" text="Métricas y Analíticas Operativas">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Separator layoutX="30.0" layoutY="55.0" prefWidth="690.0" />

        <PieChart fx:id="graficoOcupacion" layoutX="30.0" layoutY="80.0" prefHeight="300.0" prefWidth="320.0" title="Distribución de Entradas por Zona" />

        <BarChart fx:id="graficoVentas" layoutX="380.0" layoutY="80.0" prefHeight="300.0" prefWidth="340.0" title="Boletas Vendidas por Evento Top">
            <xAxis>
                <CategoryAxis side="BOTTOM" />
            </xAxis>
            <yAxis>
                <NumberAxis side="LEFT" />
            </yAxis>
        </BarChart>

        <Button layoutX="330.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleActualizarGraficos" prefHeight="30.0" prefWidth="150.0" style="-fx-base: #007bff;" text="Refrescar Gráficos" textFill="WHITE" />
        <Button layoutX="620.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleVolver" prefHeight="30.0" prefWidth="100.0" text="Volver" />
    </children>
</AnchorPane>